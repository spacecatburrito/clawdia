[Unit]
Description=Clawdia personal Telegram capture bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=clawdia
Group=clawdia
WorkingDirectory=/var/lib/clawdia
EnvironmentFile=/etc/clawdia/env
ExecStart=/opt/clawdia/.venv/bin/clawdia run
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/clawdia
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
